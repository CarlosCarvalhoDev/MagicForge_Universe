# ================================================
# MagicForge: Universe - Variáveis de Ambiente
# ================================================

# --- Servidor Node.js / WebSocket ---
PORT=3000
NODE_ENV=development

# --- Segurança & Autenticação Social ---
# Permite tokens 'mock_test_token_...' apenas em desenvolvimento/testes locais. Em produção DEVE ser false.
ALLOW_MOCK_SOCIAL_AUTH=true

# Google OAuth 2.0 (Client IDs autorizados a se conectar no backend)
# Pode ser informado um único ID ou múltiplos separados por vírgula (ex: Web, Android, iOS)
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=

# Discord OAuth 2.0 (Application / Client IDs autorizados)
DISCORD_CLIENT_IDS=
DISCORD_CLIENT_ID=

# Facebook Graph API (App IDs autorizados)
FACEBOOK_APP_IDS=
FACEBOOK_APP_ID=

# --- Cliente Web (Vite) ---
# Chaves públicas acessíveis no navegador pelo Vite (prefixo VITE_)
VITE_SERVER_URL=ws://localhost:3000
VITE_GOOGLE_CLIENT_ID=
VITE_DISCORD_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
