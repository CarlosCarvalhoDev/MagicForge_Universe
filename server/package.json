{
  "name": "@magicforge/server",
  "version": "1.0.0",
  "description": "MagicForge: Universe - 20Hz Authoritative Game Server",
  "main": "dist/server/src/index.js",
  "scripts": {
    "benchmark:progression": "tsx tools/benchmark-progression.ts",
    "benchmark:economy": "tsx tools/benchmark-economy.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:offline": "tsx --test tests/offline-rewards.test.ts tests/offline-policy.test.ts",
    "test:hunt": "tsx --test tests/hunt-report.test.ts",
    "test:automatic": "tsx --test tests/automatic-gameplay.test.ts",
    "test:skills": "tsx --test tests/skill-upgrades.test.ts ../client/tests/skill-upgrades-ui.test.ts",
    "test:inventory": "tsx --test tests/inventory-locations.test.ts ../client/tests/inventory-identity.test.ts ../client/tests/inventory-view.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["mmorpg", "authoritative-server", "websockets", "20hz"],
  "author": "MagicForge Team",
  "license": "MIT"
}
