{
  "name": "@magicforge/server",
  "version": "1.0.0",
  "description": "MagicForge: Universe - 20Hz Authoritative Game Server",
  "main": "dist/server/src/index.js",
  "scripts": {
    "benchmark:earned": "tsx tools/benchmark-earned-progression.ts",
    "test:earned": "tsx --test tests/earned-progression.test.ts tests/economy-calibration.test.ts",
    "benchmark:martial": "tsx tools/benchmark-martial.ts",
    "test:martial": "tsx --test tests/martial-effects.test.ts tests/warrior-phase1.test.ts",
    "benchmark:mage": "tsx tools/benchmark-mage.ts",
    "test:mage": "tsx --test tests/mage-initial.test.ts tests/mage-second-circle.test.ts tests/mage-ultimate.test.ts ../client/tests/skill-upgrades-ui.test.ts",
    "benchmark:cleric": "tsx tools/benchmark-cleric.ts",
    "benchmark:combat": "tsx tools/benchmark-combat-loop.ts",
    "test:combat": "tsx --test tests/combat-loop.test.ts tests/cleric-periodic.test.ts tests/cleric-ultimate.test.ts tests/starter-equipment.test.ts tests/automatic-gameplay.test.ts",
    "benchmark:progression": "tsx tools/benchmark-progression.ts",
    "benchmark:fusion": "tsx tools/benchmark-fusion.ts",
    "benchmark:economy": "tsx tools/benchmark-economy.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:offline": "tsx --test tests/offline-rewards.test.ts tests/offline-policy.test.ts",
    "test:hunt": "tsx --test tests/hunt-report.test.ts",
    "test:automatic": "tsx --test tests/automatic-gameplay.test.ts",
    "test:skills": "tsx --test tests/skill-upgrades.test.ts ../client/tests/skill-upgrades-ui.test.ts",
    "test:fusion": "tsx --test tests/equipment-fusion.test.ts ../client/tests/equipment-fusion-ui.test.ts",
    "test:inventory": "tsx --test tests/inventory-locations.test.ts tests/inventory-expansion.test.ts tests/equipment-protection.test.ts ../client/tests/inventory-identity.test.ts ../client/tests/inventory-view.test.ts ../client/tests/inventory-expansion-ui.test.ts ../client/tests/equipment-advice-ui.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["mmorpg", "authoritative-server", "websockets", "20hz"],
  "author": "MagicForge Team",
  "license": "MIT"
}
