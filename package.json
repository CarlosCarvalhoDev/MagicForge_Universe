{
  "name": "magicforge-universe",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "benchmark:progression": "npm run benchmark:progression --workspace=@magicforge/server --",
    "test:server": "npm run test --workspace=@magicforge/server",
    "test:offline": "npm run test:offline --workspace=@magicforge/server && node --test client/tests/offline-rewards-ui.test.mjs",
    "test:hunt": "npm run test:hunt --workspace=@magicforge/server && node --test client/tests/hunt-report-ui.test.mjs",
    "test:automatic": "npm run test:automatic --workspace=@magicforge/server && node --test client/tests/skill-rotation-ui.test.mjs",
    "test:skills": "npm run test:skills --workspace=@magicforge/server",
    "build": "npm run build --workspace=@magicforge/server && npm run build --workspace=@magicforge/client",
    "dev:client": "npm run dev --workspace=@magicforge/client",
    "dev:server": "npm run dev --workspace=@magicforge/server",
    "test": "node client/tests/guest-session.test.mjs && node client/tests/hero-animations.test.mjs && node client/tests/runic-ui-layout.test.mjs && node client/tests/client-network-url.test.mjs"
  }
}

