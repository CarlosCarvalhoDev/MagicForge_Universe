{
  "name": "magicforge-universe",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "benchmark:earned": "npm run benchmark:earned --workspace=@magicforge/server --",
    "test:earned": "npm run test:earned --workspace=@magicforge/server",
    "benchmark:martial": "npm run benchmark:martial --workspace=@magicforge/server --",
    "test:martial": "npm run test:martial --workspace=@magicforge/server && node --test client/tests/martial-effects-vfx.test.mjs client/tests/warrior-presentation.test.mjs client/tests/barbarian-presentation.test.mjs",
    "benchmark:mage": "npm run benchmark:mage --workspace=@magicforge/server --",
    "test:mage": "npm run test:mage --workspace=@magicforge/server && node --test client/tests/mage-initial-vfx.test.mjs client/tests/mage-second-vfx.test.mjs client/tests/mage-ultimate-vfx.test.mjs",
    "benchmark:cleric": "npm run benchmark:cleric --workspace=@magicforge/server --",
    "benchmark:combat": "npm run benchmark:combat --workspace=@magicforge/server --",
    "test:combat": "npm run test:combat --workspace=@magicforge/server && node --test client/tests/cleric-ultimate-vfx.test.mjs",
    "benchmark:progression": "npm run benchmark:progression --workspace=@magicforge/server --",
    "benchmark:fusion": "npm run benchmark:fusion --workspace=@magicforge/server --",
    "benchmark:economy": "npm run benchmark:economy --workspace=@magicforge/server --",
    "test:server": "npm run test --workspace=@magicforge/server",
    "test:offline": "npm run test:offline --workspace=@magicforge/server && node --test client/tests/offline-rewards-ui.test.mjs",
    "test:hunt": "npm run test:hunt --workspace=@magicforge/server && node --test client/tests/hunt-report-ui.test.mjs",
    "test:automatic": "npm run test:automatic --workspace=@magicforge/server && node --test client/tests/skill-rotation-ui.test.mjs",
    "test:skills": "npm run test:skills --workspace=@magicforge/server",
    "test:fusion": "npm run test:fusion --workspace=@magicforge/server",
    "test:inventory": "npm run test:inventory --workspace=@magicforge/server",
    "build": "npm run build --workspace=@magicforge/server && npm run build --workspace=@magicforge/client",
    "dev:client": "npm run dev --workspace=@magicforge/client",
    "dev:server": "npm run dev --workspace=@magicforge/server",
    "test": "node client/tests/guest-session.test.mjs && node client/tests/hero-animations.test.mjs && node client/tests/runic-ui-layout.test.mjs && node client/tests/client-network-url.test.mjs && node client/tests/barbarian-presentation.test.mjs"
  }
}

